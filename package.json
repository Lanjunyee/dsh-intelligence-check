{
  "name": "dsh-intelligence-check",
  "description": "DeepSeek Harness 原生模型质量测试与报告插件",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lanjunyee/dsh-intelligence-check.git"
  },
  "version": "0.3.0",
  "type": "module",
  "main": "./plugin/index.mjs",
  "exports": {
    ".": "./plugin/index.mjs",
    "./client": "./plugin/client.js",
    "./package.json": "./package.json"
  },
  "icon": "./assets/plugin-icon.png",
  "files": [
    "plugin",
    "cordis.patch.yml",
    "assets",
    "bin",
    "third_party",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "platforms": ["darwin", "linux", "win32"]
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "dsh": ">=0.2.0 <0.3.0"
  },
  "scripts": {
    "test": "go test -race ./...",
    "test:plugin": "node --test plugin/*.test.mjs",
    "build:client": "node scripts/build-client.mjs",
    "test:ui": "node --test scripts/ui.test.mjs",
    "test:package": "node scripts/package-check.mjs",
    "test:dsh-profile": "node scripts/dsh-profile-check.mjs",
    "test:dsh-lifecycle": "node scripts/dsh-lifecycle-check.mjs",
    "test:dsh-auto": "node scripts/dsh-auto-check.mjs",
    "test:native-attribution": "node scripts/native-attribution-check.mjs",
    "build:release": "node scripts/build-release.mjs",
    "test:install": "node scripts/install-check.mjs"
  }
}
